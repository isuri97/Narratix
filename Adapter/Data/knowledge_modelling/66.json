      "subject": {
        "entity": "Cossacks",
        "type": "ORG"
      },
      "object": {
        "entity": "ghetto",
        "type": "GHETTO_LOCATION"
      },
      "verb_pattern": "arrive"
    },
    {
      "sentence": "They dismounted, and their commander ordered to remove the barbed wire, and people braced up and came out.",

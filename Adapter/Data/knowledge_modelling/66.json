      },
      "object": {
        "entity": "Romanian side",
        "type": "LOCATION"
      },
      "verb_pattern": "take over to"
    },
    {
      "sentence": "The ghetto was split in two parts, and the colonel took us to Copaigorod, to the Romanian side.",

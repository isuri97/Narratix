        "type": "GPE"
      },
      "verb_pattern": "came back to"
    },
    {
      "sentence": "I was twelve years old when I came back from Transnistria, and I studied two more years in Russian, because Cuciurul Mare was under Russian rule by then.",
      "relationship_type": "returned_from",
      "subject": {
        "entity": "I",

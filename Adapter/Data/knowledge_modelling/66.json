      "subject": {
        "entity": "people",
        "type": "PERSON"
      },
      "object": {
        "entity": "ghetto",
        "type": "GHETTO_LOCATION"
      },
      "verb_pattern": "came out"
    },
    {
      "sentence": "Then trucks started coming, and my father went up to them and talked to the people, and we rode with the front.",
      "relationship_type": "liberated_by",
      "subject": {
        "entity": "we",
        "type": "PERSON"
      },
      "object": {

      },
      "verb_pattern": "came to"
    },
    {
      "sentence": "Many people went out of the ghetto to work.",
      "relationship_type": "worked_from",
      "subject": {
        "entity": "Many people",
        "type": "PERSON"
      },
      "object": {
        "entity": "ghetto",
        "type": "GHETTO_LOCATION"
      },
      "verb_pattern": "went out of"
    },
    {
      "sentence": "The colonel of the military unit in Snitkov - Lange was his name - asked which one of us spoke German and Ukrainian.",
      "relationship_type": "located_in",
      "subject": {
        "entity": "military unit",
        "type": "ORG"
      },
      "object": {

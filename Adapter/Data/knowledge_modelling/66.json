      },
      "object": {
        "entity": "Transnistria",
        "type": "CAMP_LOCATION"
      },
      "verb_pattern": "came back from"
    },
    {
      "sentence": "In these two years we spent in Cuciurul Mare, my father was a supervisor in a food warehouse; he distributed food to different shops.",
      "relationship_type": "worked_as",
      "subject": {
        "entity": "my father",
        "type": "PERSON"
      },
      "object": {
        "entity": "supervisor",
        "type": "OCCUPATION"
      },
      "verb_pattern": "was a"
    },
    {
